# 🖥 Ghostty Terminal Configuration (Restricted Environment Optimized)
# Location: ~/.config/ghostty/config

# —— Typography & Font ——
font-family = JetBrainsMono Nerd Font
font-family = Menlo
font-family = monospace
font-size = 15
font-thicken = true

# —— Theme & Colors ——
theme = Catppuccin Frappe
background-opacity = 0.95
background-blur-radius = 20

# —— Window & Aesthetics ——
window-padding-x = 12
window-padding-y = 12
window-decoration = true
macos-titlebar-style = transparent

# —— Cursor & Mouse ——
cursor-style = block
cursor-style-blink = false
cursor-color = #fe8019
cursor-text = #282828
mouse-hide-while-typing = true

# —— Behavior & Shell ——
confirm-close-surface = false
shell-integration = zsh
copy-on-select = true

# —— Keybindings ——
keybind = super+ctrl+r=reload_config
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+shift+w=close_tab
keybind = super+k=clear_screen

# Splits
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+shift+enter=toggle_split_zoom

# Navegação entre splits
keybind = super+alt+left=goto_split:left
keybind = super+alt+right=goto_split:right
keybind = super+alt+up=goto_split:up
keybind = super+alt+down=goto_split:down

# Redimensionar splits
keybind = super+shift+left=resize_split:left,10
keybind = super+shift+right=resize_split:right,10
keybind = super+shift+up=resize_split:up,10
keybind = super+shift+down=resize_split:down,10
